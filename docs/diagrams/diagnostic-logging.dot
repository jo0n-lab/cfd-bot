digraph diagnostics {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.5", fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fillcolor="#ecfdf5", color="#047857", fontname="Noto Sans CJK KR", fontsize=13];
  edge [fontname="Noto Sans CJK KR", fontsize=11, color="#475569"];
  ui [label="Telegram · GUI · web · CLI\n조작 / actor / 요청"];
  domain [label="기존 공용 함수 · Store\n호출 / 반환 / 분기 / 예외"];
  process [label="ofps · worker · hooks\nPID / CPU / 출력 / 종료"];
  log [label="프로세스별 JSONL\ncall · parent · trace · 시각", fillcolor="#eff6ff", color="#2563eb"];
  browser [label="브라우저 로컬 순환 로그\nUI → Promise → server trace", fillcolor="#eff6ff", color="#2563eb"];
  map [label="HLD/LLD 99개 시퀀스\nsource map / hash / step ID", fillcolor="#fff7ed", color="#ea580c"];
  control [label="공통 ON/OFF\n기본 OFF · env 우선", fillcolor="#fff7ed", color="#ea580c"];
  ui -> domain -> process;
  ui -> log [style=dashed, label="기록"];
  domain -> log [style=dashed];
  process -> log [style=dashed];
  ui -> browser [style=dashed];
  log -> map [dir=none, label="사후 연결"];
  browser -> map [dir=none];
  control -> log [style=dotted];
  control -> browser [style=dotted];
}
